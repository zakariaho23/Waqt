                            <!-- Copy Monthly Schedule Button -->
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <TextBlock x:Name="txtCopyFeedback" Text="Copied! ✓" FontSize="10.5" Foreground="#10B981" VerticalAlignment="Center" Margin="0,0,6,0" Visibility="Collapsed" />
                                <Button x:Name="btnCopyMonth" Click="BtnCopyMonth_Click"
                                        Background="#121824" BorderBrush="#00D2B4" BorderThickness="1" Foreground="#00D2B4"
                                        Height="26" Padding="9,0" FontSize="10.5" FontWeight="SemiBold" Cursor="Hand" ToolTip="Copy entire monthly timetable to clipboard">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Width="10" Height="10" Stretch="Uniform" Fill="#00D2B4" Margin="0,0,5,0"
                                              Data="M19,21H8V7H19M19,5H8A2,2 0 0,0 6,7V21A2,2 0 0,0 8,23H19A2,2 0 0,0 21,21V7A2,2 0 0,0 19,5M16,1H4A2,2 0 0,0 2,3V17H4V3H16V1Z" />
                                        <TextBlock Text="Copy Schedule" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </DockPanel>

                        <!-- Table Column Headers (All 7 Columns) -->
                        <Border Grid.Row="1" Background="#121824" BorderBrush="#1E2638" BorderThickness="0,1,0,1" Margin="10,0,10,4" Padding="8,5">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="58" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="DATE" FontSize="8.5" FontWeight="Bold" Foreground="#64748B" />
                                <TextBlock Grid.Column="1" Text="FAJR" FontSize="8.5" FontWeight="Bold" Foreground="#64748B" TextAlignment="Center" />
                                <TextBlock Grid.Column="2" Text="SUNRISE" FontSize="8.5" FontWeight="Bold" Foreground="#64748B" TextAlignment="Center" />
                                <TextBlock Grid.Column="3" Text="DHUHR" FontSize="8.5" FontWeight="Bold" Foreground="#64748B" TextAlignment="Center" />
                                <TextBlock Grid.Column="4" Text="ASR" FontSize="8.5" FontWeight="Bold" Foreground="#64748B" TextAlignment="Center" />
                                <TextBlock Grid.Column="5" Text="MAGHRIB" FontSize="8.5" FontWeight="Bold" Foreground="#64748B" TextAlignment="Center" />
                                <TextBlock Grid.Column="6" Text="ISHA" FontSize="8.5" FontWeight="Bold" Foreground="#64748B" TextAlignment="Center" />
                            </Grid>
                        </Border>

                        <!-- Scrollable Days List -->
                        <ScrollViewer Grid.Row="2" Margin="10,0,10,6" VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="icMonthlyDays">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Height="34" CornerRadius="6" Margin="0,1" Padding="8,0"
                                                Background="{Binding IsToday, Converter={x:Null}, FallbackValue='#121824'}"
                                                BorderThickness="1">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#121824" />
                                                    <Setter Property="BorderBrush" Value="#1E2638" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsToday}" Value="True">
                                                            <Setter Property="Background" Value="#0E232B" />
                                                            <Setter Property="BorderBrush" Value="#00D2B4" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <Grid VerticalAlignment="Center">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="58" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding DateString}" FontSize="10" FontWeight="SemiBold" Foreground="#F8FAFC" />
                                                    <TextBlock Text="{Binding HijriString}" FontSize="8" Foreground="#64748B" />
                                                </StackPanel>
                                                <TextBlock Grid.Column="1" Text="{Binding Fajr}" FontSize="10" Foreground="#00D2B4" TextAlignment="Center" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="2" Text="{Binding Sunrise}" FontSize="10" Foreground="#94A3B8" TextAlignment="Center" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="3" Text="{Binding Dhuhr}" FontSize="10" Foreground="#F8FAFC" TextAlignment="Center" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="4" Text="{Binding Asr}" FontSize="10" Foreground="#F8FAFC" TextAlignment="Center" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="5" Text="{Binding Maghrib}" FontSize="10" Foreground="#F59E0B" TextAlignment="Center" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="6" Text="{Binding Isha}" FontSize="10" Foreground="#818CF8" TextAlignment="Center" VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>

                    <!-- ==================================================== -->
                    <!-- VIEW 4: SETTINGS PANEL                               -->
                    <!-- ==================================================== -->
                    <Grid x:Name="SettingsPanel" Visibility="Collapsed" Background="#0B0F17">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />   <!-- Scrollable Form -->
                            <RowDefinition Height="Auto" /> <!-- Save Button Footer -->
                        </Grid.RowDefinitions>

                        <!-- Scrollable Settings Form -->
                        <ScrollViewer Grid.Row="0" Margin="14,6,14,4" VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="0,0,6,10">
                                <!-- Section 1: Location -->
                                <Border Background="#121824" BorderBrush="#1E2638" BorderThickness="1" CornerRadius="10" Padding="12,10" Margin="0,0,0,10">
                                    <StackPanel>
                                        <DockPanel Margin="0,0,0,8">
                                            <TextBlock Text="LOCATION &amp; TIMEZONE" FontSize="10" FontWeight="Bold" Foreground="#00D2B4" VerticalAlignment="Center" />
                                            <Button x:Name="btnAutoDetect" DockPanel.Dock="Right" Click="BtnAutoDetect_Click"
                                                    Background="#1A2232" BorderBrush="#00D2B4" BorderThickness="1" Foreground="#00D2B4"
                                                    Height="22" Padding="8,0" FontSize="10" FontWeight="SemiBold" Cursor="Hand" HorizontalAlignment="Right"
                                                    ToolTip="Auto-detect current location via IP">
                                                <StackPanel Orientation="Horizontal">
                                                    <Path Width="10" Height="10" Stretch="Uniform" Fill="#00D2B4" Margin="0,0,4,0"
                                                          Data="M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 12,2M12,4A8,8 0 0,1 20,12A8,8 0 0,1 12,20A8,8 0 0,1 4,12A8,8 0 0,1 12,4M11,6V9.08C8.94,9.5 7.5,10.94 7.08,13H4V15H7.08C7.5,17.06 8.94,18.5 11,18.92V22H13V18.92C15.06,18.5 16.5,17.06 16.92,15H20V13H16.92C16.5,10.94 15.06,9.5 13,9.08V6H11Z" />
                                                    <TextBlock Text="Auto-Detect" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Button>
                                        </DockPanel>

                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="8" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="Country" FontSize="11" Foreground="#94A3B8" Margin="0,0,0,3" />
                                                <ComboBox x:Name="cmbCountry" Height="30" IsEditable="False" IsTextSearchEnabled="True" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="City" FontSize="11" Foreground="#94A3B8" Margin="0,0,0,3" />
                                                <ComboBox x:Name="cmbCity" Height="30" IsEditable="False" IsTextSearchEnabled="True" />
                                            </StackPanel>
                                        </Grid>

                                        <DockPanel Margin="0,4,0,0">
                                            <Button x:Name="btnVerifyLocation" DockPanel.Dock="Left" Content="Fetch &amp; Verify" Click="BtnVerifyLocation_Click"
                                                    Background="#1A2232" BorderBrush="#00D2B4" BorderThickness="1" Foreground="#00D2B4"
                                                    Height="24" Padding="9,0" FontSize="10.5" FontWeight="SemiBold" Cursor="Hand" />
                                            <TextBlock x:Name="lblResolvedTimezone" DockPanel.Dock="Right" Text="Europe/Istanbul" 
                                                       FontSize="10" Foreground="#94A3B8" VerticalAlignment="Center" HorizontalAlignment="Right" />
                                        </DockPanel>
                                    </StackPanel>
                                </Border>

                                <!-- Section 2: Calculation Method -->
                                <Border Background="#121824" BorderBrush="#1E2638" BorderThickness="1" CornerRadius="10" Padding="12,10" Margin="0,0,0,10">
                                    <StackPanel>
                                        <TextBlock Text="CALCULATION METHOD" FontSize="10" FontWeight="Bold" Foreground="#00D2B4" Margin="0,0,0,8" />
                                        <TextBlock Text="Authority" FontSize="11" Foreground="#94A3B8" Margin="0,0,0,3" />
                                        <ComboBox x:Name="cmbMethod" Height="30" Margin="0,0,0,8">
                                            <ComboBoxItem Tag="13" IsSelected="True" Content="13 — Diyanet İşleri Başkanlığı (Turkey)" />
                                            <ComboBoxItem Tag="3" Content="3 — Muslim World League (MWL)" />
                                            <ComboBoxItem Tag="2" Content="2 — Islamic Society of North America (ISNA)" />
                                            <ComboBoxItem Tag="4" Content="4 — Umm al-Qura University, Makkah" />
                                            <ComboBoxItem Tag="5" Content="5 — Egyptian General Authority of Survey" />
                                            <ComboBoxItem Tag="1" Content="1 — University of Islamic Sciences, Karachi" />
                                        </ComboBox>

                                        <TextBlock Text="Asr Juristic School" FontSize="11" Foreground="#94A3B8" Margin="0,0,0,3" />
                                        <ComboBox x:Name="cmbAsrSchool" Height="30">
                                            <ComboBoxItem Tag="0" IsSelected="True" Content="Standard (Shafi'i, Maliki, Hanbali)" />
                                            <ComboBoxItem Tag="1" Content="Hanafi" />
                                        </ComboBox>
                                    </StackPanel>
                                </Border>

                                <!-- Section 3: Display & Clock Formats -->
                                <Border Background="#121824" BorderBrush="#1E2638" BorderThickness="1" CornerRadius="10" Padding="12,10" Margin="0,0,0,10">
                                    <StackPanel>
                                        <TextBlock Text="DISPLAY &amp; CLOCK FORMATS" FontSize="10" FontWeight="Bold" Foreground="#00D2B4" Margin="0,0,0,6" />
                                        <CheckBox x:Name="chk12HourFormat" Style="{StaticResource FluentToggleSwitch}" Content="12-Hour Clock Format (e.g. 05:21 AM)" IsChecked="False" Margin="0,0,0,4" />
                                        <CheckBox x:Name="chkShowDailyVerse" Style="{StaticResource FluentToggleSwitch}" Content="Show Daily Quran Ayah &amp; Wisdom" IsChecked="True" />
                                    </StackPanel>
                                </Border>

                                <!-- Section 4: Notifications & Audio -->
                                <Border Background="#121824" BorderBrush="#1E2638" BorderThickness="1" CornerRadius="10" Padding="12,10" Margin="0,0,0,10">
                                    <StackPanel>
                                        <TextBlock Text="NOTIFICATIONS &amp; ATHAN AUDIO" FontSize="10" FontWeight="Bold" Foreground="#00D2B4" Margin="0,0,0,6" />
                                        <CheckBox x:Name="chkToastEnabled" Style="{StaticResource FluentToggleSwitch}" Content="Windows 11 Toast Notifications" IsChecked="True" Margin="0,0,0,4" />
                                        <CheckBox x:Name="chkAthanEnabled" Style="{StaticResource FluentToggleSwitch}" Content="Play Athan Audio at Prayer Time" IsChecked="True" Margin="0,0,0,8" />

                                        <TextBlock Text="Pre-Prayer Reminder" FontSize="11" Foreground="#94A3B8" Margin="0,0,0,3" />
                                        <ComboBox x:Name="cmbPreReminder" Height="30" Margin="0,0,0,8">
                                            <ComboBoxItem Tag="0" IsSelected="True" Content="Off" />
                                            <ComboBoxItem Tag="5" Content="5 minutes before" />
                                            <ComboBoxItem Tag="10" Content="10 minutes before" />
                                            <ComboBoxItem Tag="15" Content="15 minutes before" />
                                            <ComboBoxItem Tag="20" Content="20 minutes before" />
                                        </ComboBox>

                                        <TextBlock Text="Custom Athan Sound File (.mp3 / .wav)" FontSize="11" Foreground="#94A3B8" Margin="0,0,0,3" />
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="6" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBox x:Name="txtAudioPath" Text="Built-in Harmonic Chime" IsReadOnly="True" Height="28" VerticalContentAlignment="Center" FontSize="10.5" />
                                            <Button Grid.Column="2" Content="Browse..." Click="BtnBrowseAudio_Click" Height="28" Padding="9,0" Background="#1A2232" Foreground="#F8FAFC" BorderBrush="#1E2638" BorderThickness="1" Cursor="Hand" />
                                        </Grid>
                                        
                                        <DockPanel>
                                            <Button Content="Reset to Chime" Click="BtnResetAudio_Click" Background="Transparent" BorderThickness="0" Foreground="#00D2B4" FontSize="10.5" HorizontalAlignment="Left" Cursor="Hand" />
                                            <Button x:Name="btnTestAudioPreview" DockPanel.Dock="Right" Content="▶ Test / Preview Athan" Click="BtnTestAlert_Click"
                                                    Background="#1A2232" BorderBrush="#00D2B4" BorderThickness="1" Foreground="#00D2B4"
                                                    Height="24" Padding="8,0" FontSize="10.5" FontWeight="SemiBold" Cursor="Hand" HorizontalAlignment="Right" />
                                        </DockPanel>
                                    </StackPanel>
                                </Border>

                                <!-- Section 5: Mosque Minute Offsets Calibration -->
                                <Border Background="#121824" BorderBrush="#1E2638" BorderThickness="1" CornerRadius="10" Padding="12,10" Margin="0,0,0,10">
                                    <StackPanel>
                                        <TextBlock Text="LOCAL MOSQUE MINUTE CALIBRATION (+/- MINS)" FontSize="10" FontWeight="Bold" Foreground="#00D2B4" Margin="0,0,0,4" />
                                        <TextBlock Text="Fine-tune prayer times to match your local mosque:" FontSize="10" Foreground="#64748B" Margin="0,0,0,8" />
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="70" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="35" />
                                            </Grid.ColumnDefinitions>

                                            <!-- Fajr Offset -->
                                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Fajr:" FontSize="11" Foreground="#94A3B8" VerticalAlignment="Center" />
                                            <Slider x:Name="sliderOffsetFajr" Grid.Row="0" Grid.Column="1" Minimum="-15" Maximum="15" TickFrequency="1" IsSnapToTickEnabled="True" Value="0" ValueChanged="SliderOffset_ValueChanged" VerticalAlignment="Center" />
                                            <TextBlock x:Name="txtOffsetFajr" Grid.Row="0" Grid.Column="2" Text="0m" FontSize="10.5" Foreground="#00D2B4" HorizontalAlignment="Right" VerticalAlignment="Center" />

                                            <!-- Dhuhr Offset -->
                                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Dhuhr:" FontSize="11" Foreground="#94A3B8" VerticalAlignment="Center" Margin="0,5,0,0" />
                                            <Slider x:Name="sliderOffsetDhuhr" Grid.Row="1" Grid.Column="1" Minimum="-15" Maximum="15" TickFrequency="1" IsSnapToTickEnabled="True" Value="0" ValueChanged="SliderOffset_ValueChanged" VerticalAlignment="Center" Margin="0,5,0,0" />
                                            <TextBlock x:Name="txtOffsetDhuhr" Grid.Row="1" Grid.Column="2" Text="0m" FontSize="10.5" Foreground="#00D2B4" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,5,0,0" />

                                            <!-- Asr Offset -->
                                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Asr:" FontSize="11" Foreground="#94A3B8" VerticalAlignment="Center" Margin="0,5,0,0" />
                                            <Slider x:Name="sliderOffsetAsr" Grid.Row="2" Grid.Column="1" Minimum="-15" Maximum="15" TickFrequency="1" IsSnapToTickEnabled="True" Value="0" ValueChanged="SliderOffset_ValueChanged" VerticalAlignment="Center" Margin="0,5,0,0" />
                                            <TextBlock x:Name="txtOffsetAsr" Grid.Row="2" Grid.Column="2" Text="0m" FontSize="10.5" Foreground="#00D2B4" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,5,0,0" />

                                            <!-- Maghrib Offset -->
                                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Maghrib:" FontSize="11" Foreground="#94A3B8" VerticalAlignment="Center" Margin="0,5,0,0" />
                                            <Slider x:Name="sliderOffsetMaghrib" Grid.Row="3" Grid.Column="1" Minimum="-15" Maximum="15" TickFrequency="1" IsSnapToTickEnabled="True" Value="0" ValueChanged="SliderOffset_ValueChanged" VerticalAlignment="Center" Margin="0,5,0,0" />
                                            <TextBlock x:Name="txtOffsetMaghrib" Grid.Row="3" Grid.Column="2" Text="0m" FontSize="10.5" Foreground="#00D2B4" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,5,0,0" />

                                            <!-- Isha Offset -->
                                            <TextBlock Grid.Row="4" Grid.Column="0" Text="Isha:" FontSize="11" Foreground="#94A3B8" VerticalAlignment="Center" Margin="0,5,0,0" />
                                            <Slider x:Name="sliderOffsetIsha" Grid.Row="4" Grid.Column="1" Minimum="-15" Maximum="15" TickFrequency="1" IsSnapToTickEnabled="True" Value="0" ValueChanged="SliderOffset_ValueChanged" VerticalAlignment="Center" Margin="0,5,0,0" />
                                            <TextBlock x:Name="txtOffsetIsha" Grid.Row="4" Grid.Column="2" Text="0m" FontSize="10.5" Foreground="#00D2B4" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,5,0,0" />
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- Section 6: System Integration -->
                                <Border Background="#121824" BorderBrush="#1E2638" BorderThickness="1" CornerRadius="10" Padding="12,10" Margin="0,0,0,6">
                                    <StackPanel>
                                        <TextBlock Text="SYSTEM INTEGRATION" FontSize="10" FontWeight="Bold" Foreground="#00D2B4" Margin="0,0,0,6" />
                                        <CheckBox x:Name="chkLaunchStartup" Style="{StaticResource FluentToggleSwitch}" Content="Launch Waqt automatically when Windows starts" IsChecked="False" Margin="0,0,0,6" />

                                        <!-- Attribution Line -->
                                        <Button Background="Transparent" BorderThickness="0" Cursor="Hand" Click="BtnAttribution_Click" HorizontalAlignment="Center" Margin="0,4,0,0">
                                            <TextBlock Text="Made by Zakaria Haj Othman • github.com/zakariaho23" FontSize="9.5" Foreground="#64748B" />
                                        </Button>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- Save & Apply Footer -->
                        <Border Grid.Row="1" BorderBrush="#1E2638" BorderThickness="0,1,0,0" Padding="14,8,14,8">
                            <StackPanel>
                                <TextBlock x:Name="lblSaveStatus" Text="Settings saved &amp; applied ✓" FontSize="11" Foreground="#10B981"
                                           HorizontalAlignment="Center" Margin="0,0,0,4" Visibility="Collapsed" />
                                <Button x:Name="btnSaveSettings" Content="Save &amp; Apply Changes" Click="BtnSaveSettings_Click"
                                        Background="#00D2B4" Foreground="#0B0F17" FontWeight="Bold" FontSize="12.5"
                                        Height="36" Cursor="Hand">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="8">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>

                <!-- ======================================================== -->
                <!-- BOTTOM SEGMENTED NAVIGATION PILL BAR                     -->
                <!-- ======================================================== -->
                <Border Grid.Row="2" Background="#0E131E" BorderBrush="#1C2536" BorderThickness="0,1,0,0" Padding="10,6">
                    <!-- Modern WinUI Segmented Pill Container -->
                    <Border Background="#121824" CornerRadius="10" BorderBrush="#1E2638" BorderThickness="1" Padding="3">
                        <UniformGrid Columns="4">
                            <!-- Tab 1: Today Prayers -->
                            <Button x:Name="navBtnToday" Click="NavToday_Click" Style="{StaticResource NavTabButtonStyle}">
                                <StackPanel Orientation="Horizontal">
                                    <!-- Crisp Vector Clock Icon -->
                                    <Path Width="12" Height="12" Stretch="Uniform" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Margin="0,0,5,0" VerticalAlignment="Center"
                                          Data="M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 22,12A10,10 0 0,0 12,2M12,4A8,8 0 0,1 20,12A8,8 0 0,1 12,20A8,8 0 0,1 4,12A8,8 0 0,1 12,4M12.5,7V12.25L17,14.92L16.25,16.15L11,13V7H12.5Z" />
                                    <TextBlock Text="Prayers" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <!-- Tab 2: Qibla -->
                            <Button x:Name="navBtnQibla" Click="NavQibla_Click" Style="{StaticResource NavTabButtonStyle}">
                                <StackPanel Orientation="Horizontal">
                                    <!-- Crisp Vector Compass Icon -->
                                    <Path Width="12" Height="12" Stretch="Uniform" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Margin="0,0,5,0" VerticalAlignment="Center"
                                          Data="M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 22,12A10,10 0 0,0 12,2M12,4A8,8 0 0,1 20,12A8,8 0 0,1 12,20A8,8 0 0,1 4,12A8,8 0 0,1 12,4M7.91,16.09L9.67,11.23L14.53,9.47L12.77,14.33L7.91,16.09M11.1,12.9A1.3,1.3 0 0,0 12.9,11.1A1.3,1.3 0 0,0 11.1,12.9Z" />
                                    <TextBlock Text="Qibla" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <!-- Tab 3: Monthly Timetable (Imsakiyah) -->
                            <Button x:Name="navBtnMonthly" Click="NavMonthly_Click" Style="{StaticResource NavTabButtonStyle}">
                                <StackPanel Orientation="Horizontal">
                                    <!-- Crisp Vector Calendar Icon -->
                                    <Path Width="12" Height="12" Stretch="Uniform" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Margin="0,0,5,0" VerticalAlignment="Center"
                                          Data="M19,19H5V8H19M16,1V3H8V1H6V3H5C3.89,3 3,3.89 3,5V19A2,2 0 0,0 5,21H19A2,2 0 0,0 21,19V5C21,3.89 20.1,3 19,3H18V1M17,12H12V17H17V12Z" />
                                    <TextBlock Text="Imsakiyah" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <!-- Tab 4: Settings -->
                            <Button x:Name="navBtnSettings" Click="NavSettings_Click" Style="{StaticResource NavTabButtonStyle}">
                                <StackPanel Orientation="Horizontal">
