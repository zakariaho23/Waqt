                    <!-- ==================================================== -->
                    <!-- VIEW 2: QIBLA COMPASS                                -->
                    <!-- ==================================================== -->
                    <Grid x:Name="QiblaPanel" Visibility="Collapsed" Background="#0B0F17">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="14,10,14,14" HorizontalAlignment="Center">
                                <TextBlock Text="QIBLA COMPASS" FontSize="11" FontWeight="Bold" Foreground="#00D2B4" HorizontalAlignment="Center" Margin="0,0,0,3" />
                                <TextBlock x:Name="txtQiblaSubtitle" Text="Facing towards the Holy Kaaba in Makkah al-Mukarramah" FontSize="11" Foreground="#94A3B8" HorizontalAlignment="Center" Margin="0,0,0,8" />

                                <!-- Live Alignment Status Banner -->
                                <Border x:Name="badgeQiblaAlignment" Background="#0E2D27" BorderBrush="#10B981" BorderThickness="1" CornerRadius="16" Padding="12,5" HorizontalAlignment="Center" Margin="0,0,0,6" Visibility="Collapsed">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Width="12" Height="12" Stretch="Uniform" Fill="#10B981" Margin="0,0,6,0" VerticalAlignment="Center"
                                              Data="M12,2A10,10 0 0,1 22,12A10,10 0 0,1 12,22A10,10 0 0,1 2,12A10,10 0 0,1 12,2M10,17L19,8L17.59,6.58L10,14.17L6.41,10.59L5,12L10,17Z" />
                                        <TextBlock Text="YOU ARE FACING THE QIBLA ✓" FontSize="11" FontWeight="Bold" Foreground="#10B981" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Border>

                                <!-- Directional Turning Advice -->
                                <TextBlock x:Name="txtTurnGuidance" Text="Calculating Qibla direction..." FontSize="11" Foreground="#94A3B8" FontWeight="SemiBold" TextAlignment="Center" Margin="0,0,0,10" Width="330" TextWrapping="Wrap" />

                                <!-- Circular Compass Dial Surface (200x200) -->
                                <Grid Width="200" Height="200" Margin="0,0,0,12" HorizontalAlignment="Center">
                                    <!-- Outer Precision Astrolabe Rim -->
                                    <Ellipse Stroke="#1E2638" StrokeThickness="2.5" Fill="#121824" />
                                    <!-- Subtle inner rings & ticks -->
                                    <Ellipse Stroke="#00D2B4" StrokeThickness="1" Opacity="0.2" Margin="6" />
                                    <Ellipse Stroke="#253046" StrokeThickness="1" StrokeDashArray="2 4" Margin="14" />
                                    <Ellipse Stroke="#1E2638" StrokeThickness="1" Margin="24" />

                                    <!-- North Indicator Arrow Tip -->
                                    <Path Data="M 97,5 L 103,5 L 100,10 Z" Fill="#00D2B4" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,5,0,0" />

                                    <!-- Cardinal Points -->
                                    <TextBlock Text="N" FontWeight="Bold" FontSize="12.5" Foreground="#00D2B4" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,11,0,0" />
                                    <TextBlock Text="S" FontWeight="Bold" FontSize="11.5" Foreground="#94A3B8" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,10" />
                                    <TextBlock Text="E" FontWeight="Bold" FontSize="11.5" Foreground="#94A3B8" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0" />
                                    <TextBlock Text="W" FontWeight="Bold" FontSize="11.5" Foreground="#94A3B8" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="12,0,0,0" />

                                    <!-- Intercardinal Points -->
                                    <TextBlock Text="NE" FontSize="8.5" FontWeight="SemiBold" Foreground="#475569" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,38,36,0" />
                                    <TextBlock Text="SE" FontSize="8.5" FontWeight="SemiBold" Foreground="#475569" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,36,38" />
                                    <TextBlock Text="SW" FontSize="8.5" FontWeight="SemiBold" Foreground="#475569" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="36,0,0,38" />
                                    <TextBlock Text="NW" FontSize="8.5" FontWeight="SemiBold" Foreground="#475569" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="36,38,0,0" />

                                    <!-- Center Rotating Qibla Needle (Centered at 100, 100) -->
                                    <Canvas Width="200" Height="200" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Canvas.RenderTransform>
                                            <RotateTransform x:Name="qiblaNeedleRotation" CenterX="100" CenterY="100" Angle="0" />
                                        </Canvas.RenderTransform>

                                        <!-- Top Pointer (Pointing to Kaaba) -->
                                        <Path Data="M 94,100 L 100,24 L 106,100 Z" Fill="#00D2B4">
                                            <Path.Effect>
                                                <DropShadowEffect BlurRadius="12" Color="#00D2B4" Opacity="0.6" ShadowDepth="0" />
                                            </Path.Effect>
                                        </Path>
                                        <!-- Top Spine Ridge -->
                                        <Line X1="100" Y1="25" X2="100" Y2="100" Stroke="#A7F3D0" StrokeThickness="1" Opacity="0.9" />

                                        <!-- Bottom Counterweight -->
                                        <Path Data="M 94,100 L 100,176 L 106,100 Z" Fill="#334155" />
                                        <!-- Bottom Spine Ridge -->
                                        <Line X1="100" Y1="100" X2="100" Y2="175" Stroke="#1E293B" StrokeThickness="1" />
                                    </Canvas>

                                    <!-- Fixed Center Hub: Golden Kaaba Emblem -->
                                    <Border Width="30" Height="30" CornerRadius="15" Background="#0B0F17" BorderBrush="#00D2B4" BorderThickness="1.5" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Width="14" Height="14">
                                            <Rectangle Fill="#1E2638" RadiusX="1.5" RadiusY="1.5" Width="14" Height="14" />
                                            <Rectangle Fill="#F59E0B" Height="2.5" VerticalAlignment="Top" Margin="0,3,0,0" />
                                            <Rectangle Fill="#E2E8F0" Width="2" Height="3" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,2,2" />
                                        </Grid>
                                    </Border>
                                </Grid>

                                <!-- Digital Angle & Location Readout Card -->
                                <Border Background="#121824" BorderBrush="#1E2638" BorderThickness="1" CornerRadius="10" Padding="14,10" Width="338" Margin="0,0,0,8">
                                    <StackPanel HorizontalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <TextBlock x:Name="txtQiblaDegrees" Text="--.-°" FontSize="30" FontWeight="SemiBold" Foreground="#00D2B4" Typography.NumeralAlignment="Tabular" />
                                            <Border Background="#1A2232" CornerRadius="4" Padding="6,2" Margin="10,0,0,5" VerticalAlignment="Bottom">
                                                <TextBlock x:Name="txtQiblaCardinal" Text="--" FontSize="13" FontWeight="Bold" Foreground="#F8FAFC" />
                                            </Border>
                                        </StackPanel>

                                        <TextBlock x:Name="txtQiblaDistance" Text="-- km to Holy Kaaba, Makkah" FontSize="11.5" Foreground="#94A3B8" HorizontalAlignment="Center" Margin="0,2,0,0" />
                                        <TextBlock x:Name="txtQiblaCoordinates" Text="Latitude: -- • Longitude: --" FontSize="10" Foreground="#64748B" HorizontalAlignment="Center" Margin="0,3,0,0" />
                                    </StackPanel>
                                </Border>

                                <!-- Orientation Calibration / Device Heading Controls -->
                                <Border Background="#121824" BorderBrush="#1E2638" BorderThickness="1" CornerRadius="10" Padding="12,10" Width="338" Margin="0,0,0,8">
                                    <StackPanel>
                                        <DockPanel Margin="0,0,0,4">
                                            <TextBlock Text="DEVICE / ROOM ORIENTATION" FontSize="9.5" FontWeight="Bold" Foreground="#00D2B4" DockPanel.Dock="Left" VerticalAlignment="Center" />
                                            <TextBlock x:Name="txtCurrentHeading" Text="0° (Facing North)" FontSize="10.5" FontWeight="SemiBold" Foreground="#F8FAFC" DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                        </DockPanel>
                                        
                                        <!-- Heading Slider (0° - 359°) -->
                                        <Slider x:Name="sliderHeading" Minimum="0" Maximum="359" Value="0" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="SliderHeading_ValueChanged" Margin="0,2,0,6" />
                                        
                                        <!-- Quick Orientation Presets -->
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="4" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="4" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="4" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="4" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Button Grid.Column="0" Content="N (0°)" Click="BtnPresetHeading_Click" Tag="0" Height="24" FontSize="9.5" Background="#1A2232" BorderBrush="#1E2638" Foreground="#94A3B8" Padding="0" Cursor="Hand" />
                                            <Button Grid.Column="2" Content="E (90°)" Click="BtnPresetHeading_Click" Tag="90" Height="24" FontSize="9.5" Background="#1A2232" BorderBrush="#1E2638" Foreground="#94A3B8" Padding="0" Cursor="Hand" />
                                            <Button Grid.Column="4" Content="S (180°)" Click="BtnPresetHeading_Click" Tag="180" Height="24" FontSize="9.5" Background="#1A2232" BorderBrush="#1E2638" Foreground="#94A3B8" Padding="0" Cursor="Hand" />
                                            <Button Grid.Column="6" Content="W (270°)" Click="BtnPresetHeading_Click" Tag="270" Height="24" FontSize="9.5" Background="#1A2232" BorderBrush="#1E2638" Foreground="#94A3B8" Padding="0" Cursor="Hand" />
                                            <Button Grid.Column="8" Content="🎯 Align to Qibla" Click="BtnPresetFaceQibla_Click" Height="24" FontSize="9.5" FontWeight="SemiBold" Background="#0F2830" BorderBrush="#00D2B4" Foreground="#00D2B4" Padding="6,0" Cursor="Hand" ToolTip="Set heading to match Qibla bearing" />
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- Helpful Guidance Tip -->
                                <TextBlock Text="Tip: If your screen faces North (0°), turn towards the needle direction. Drag the slider to match your room direction."
                                           FontSize="10" Foreground="#64748B" TextAlignment="Center" TextWrapping="Wrap" Margin="10,2,10,0" Width="324" />
                            </StackPanel>
                        </ScrollViewer>
