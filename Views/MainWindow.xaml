<Window x:Class="Waqt.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:tb="clr-namespace:H.NotifyIcon;assembly=H.NotifyIcon.Wpf"
        mc:Ignorable="d"
        Title="Waqt"
        Width="396" Height="640"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        FontFamily="Segoe UI Variable Display, Segoe UI"
        Deactivated="Window_Deactivated"
        Loaded="Window_Loaded">

    <Window.Resources>
        <!-- Windows 11 Fluent Toggle Switch Style for CheckBox -->
        <Style x:Key="FluentToggleSwitch" TargetType="CheckBox">
            <Setter Property="Foreground" Value="#F8FAFC" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Margin="0,3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            
                            <!-- Label Text -->
                            <ContentPresenter Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0" />
                            
                            <!-- Toggle Track -->
                            <Border x:Name="SwitchTrack" Grid.Column="1"
                                    Width="38" Height="20"
                                    CornerRadius="10"
                                    Background="#1A2232"
                                    BorderBrush="#253046"
                                    BorderThickness="1">
                                <!-- Toggle Thumb -->
                                <Ellipse x:Name="SwitchThumb"
                                         Width="14" Height="14"
                                         Fill="#94A3B8"
                                         HorizontalAlignment="Left"
                                         Margin="3,0,0,0">
                                    <Ellipse.RenderTransform>
                                        <TranslateTransform x:Name="ThumbTransform" X="0" />
                                    </Ellipse.RenderTransform>
                                </Ellipse>
                            </Border>
                        </Grid>
                        
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="SwitchTrack" Property="Background" Value="#00D2B4" />
                                <Setter TargetName="SwitchTrack" Property="BorderBrush" Value="#00D2B4" />
                                <Setter TargetName="SwitchThumb" Property="Fill" Value="#0B0F17" />
                                <Setter TargetName="SwitchThumb" Property="Margin" Value="19,0,0,0" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="SwitchTrack" Property="BorderBrush" Value="#00D2B4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Header Icon Button Style -->
        <Style x:Key="HeaderIconButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="#94A3B8" />
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#1A2232" />
                                <Setter Property="Foreground" Value="#00D2B4" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#253046" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Per-prayer alert bell toggle style -->
        <Style x:Key="PrayerBellButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Width" Value="26" />
            <Setter Property="Height" Value="26" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#1E283A" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <!-- Windows 11 System Tray TaskbarIcon -->
        <tb:TaskbarIcon x:Name="TrayIcon"
                        ToolTipText="Waqt • Loading prayer times..."
                        TrayLeftMouseDown="TrayIcon_TrayLeftMouseDown">
            <tb:TaskbarIcon.ContextMenu>
                <ContextMenu Background="#121824" BorderBrush="#1E2638" BorderThickness="1">
                    <MenuItem x:Name="trayMenuNextPrayer" Header="Next: Loading..." FontWeight="Bold" Foreground="#00D2B4" IsEnabled="False" />
                    <Separator Background="#1E2638" />
                    <MenuItem Header="Open Waqt" Click="MenuOpen_Click" FontWeight="SemiBold" Foreground="#F8FAFC" />
                    <MenuItem Header="Copy Today's Timetable" Click="MenuCopyTimetable_Click" Foreground="#F8FAFC" />
                    <MenuItem Header="Refresh Timings" Click="MenuRefresh_Click" Foreground="#F8FAFC" />
                    <Separator Background="#1E2638" />
                    <MenuItem x:Name="menuMuteToggle" Header="Mute Athan" Click="MenuMuteToggle_Click" Foreground="#F8FAFC" />
                    <MenuItem Header="Test Notification &amp; Athan" Click="MenuTestAlert_Click" Foreground="#F8FAFC" />
                    <MenuItem Header="Settings" Click="MenuSettings_Click" Foreground="#F8FAFC" />
                    <Separator Background="#1E2638" />
                    <MenuItem Header="Exit Waqt" Click="MenuExit_Click" Foreground="#EF4444" />
                </ContextMenu>
            </tb:TaskbarIcon.ContextMenu>
        </tb:TaskbarIcon>

        <!-- Outer Elevated Window Shell with Drop Shadow -->
        <Border x:Name="MainContainer"
                Background="#0B0F17"
                BorderThickness="1"
                CornerRadius="16"
                Margin="8">
            <Border.BorderBrush>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#334155" Offset="0" />
                    <GradientStop Color="#1E2638" Offset="0.3" />
                    <GradientStop Color="#151C28" Offset="1" />
                </LinearGradientBrush>
            </Border.BorderBrush>
            <Border.Effect>
                <DropShadowEffect BlurRadius="28" ShadowDepth="4" Direction="270" Color="#000000" Opacity="0.8" />
            </Border.Effect>
            <Border.RenderTransform>
                <TranslateTransform x:Name="FlyoutTransform" Y="0" />
            </Border.RenderTransform>

            <Grid ClipToBounds="True">
                <Grid.RowDefinitions>
                    <RowDefinition Height="46" /> <!-- Window Header -->
                    <RowDefinition Height="*" />  <!-- Main Active View Content -->
                    <RowDefinition Height="50" /> <!-- Bottom Navigation Bar -->
                </Grid.RowDefinitions>

                <!-- ======================================================== -->
                <!-- TOP HEADER BAR                                           -->
                <!-- ======================================================== -->
                <Grid Grid.Row="0" Margin="14,6,14,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Brand Logo + Name -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Viewbox Width="20" Height="20" Margin="0,0,8,0">
                            <Canvas Width="24" Height="24">
                                <Path Fill="#00D2B4" Data="M12 2A10 10 0 1 0 22 12A10 10 0 0 1 12 2Z" />
                                <Path Fill="#00D2B4" Data="M18 6L18.8 8L21 8.3L19.4 9.8L19.8 12L18 10.9L16.2 12L16.6 9.8L15 8.3L17.2 8Z" />
                            </Canvas>
                        </Viewbox>
                        <TextBlock Text="Waqt" FontSize="16" FontWeight="SemiBold" Foreground="#F8FAFC" VerticalAlignment="Center" />
                        <!-- Subtle status indicator -->
                        <Ellipse x:Name="dotSyncStatus" Width="6" Height="6" Fill="#10B981" Margin="9,0,0,0" VerticalAlignment="Center" ToolTip="Timings Status" />
                    </StackPanel>

                    <!-- Top Right Quick Controls -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Audio Master Mute Toggle -->
                        <Button x:Name="btnMasterMute" Style="{StaticResource HeaderIconButton}" Click="BtnMasterMute_Click" ToolTip="Mute/Unmute Audio" Margin="0,0,2,0">
                            <Path x:Name="iconMasterMute" Width="13" Height="13" Stretch="Uniform" Fill="#00D2B4"
                                  Data="M14,3.23V5.29C16.89,6.15 19,8.83 19,12C19,15.17 16.89,17.85 14,18.71V20.77C18.01,19.86 21,16.28 21,12C21,7.72 18.01,4.14 14,3.23M16.5,12C16.5,10.23 15.5,8.71 14,7.97V16C15.5,15.29 16.5,13.77 16.5,12M3,9V15H7L12,20V4L7,9H3Z" />
                        </Button>

                        <!-- Pin Flyout Toggle -->
                        <Button x:Name="btnPin" Style="{StaticResource HeaderIconButton}" Click="BtnPin_Click" ToolTip="Keep open when clicking outside">
                            <Path x:Name="iconPin" Width="13" Height="13" Stretch="Uniform" Fill="#94A3B8"
                                  Data="M16,12V4H17V2H7V4H8V12L6,14V16H11V22H13V16H18V14L16,12Z" />
                        </Button>

                        <!-- Close / Hide to Tray -->
                        <Button Style="{StaticResource HeaderIconButton}" Click="BtnClose_Click" ToolTip="Hide to Tray" Margin="2,0,0,0">
                            <Path Width="11" Height="11" Stretch="Uniform" Fill="#94A3B8"
                                  Data="M19,6.41L17.59,5L12,10.59L6.41,5L5,6.41L10.59,12L5,17.59L6.41,19L12,13.41L17.59,19L19,17.59L13.41,12L19,6.41Z" />
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- ======================================================== -->
                <!-- CONTENT CONTAINER (PANELS)                               -->
                <!-- ======================================================== -->
                <Grid Grid.Row="1">
                    <!-- ==================================================== -->
                    <!-- VIEW 1: TODAY'S TIMETABLE DASHBOARD                  -->
                    <!-- ==================================================== -->
                    <Grid x:Name="DashboardPanel" Visibility="Visible">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Margin="14,0,14,4">
                                <!-- Location & Dual-Date Strip -->
                                <DockPanel LastChildFill="False" Margin="0,2,0,6">
                                    <Button DockPanel.Dock="Left" Background="Transparent" BorderThickness="0" Cursor="Hand" Click="BtnLocation_Click" Padding="0">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Width="11" Height="11" Stretch="Uniform" Fill="#00D2B4" Margin="0,0,5,0"
                                                  Data="M12,2C8.13,2 5,5.13 5,9C5,14.25 12,22 12,22C12,22 19,14.25 19,9C19,5.13 15.87,2 12,2M12,11.5A2.5,2.5 0 0,1 9.5,9A2.5,2.5 0 0,1 12,6.5A2.5,2.5 0 0,1 14.5,9A2.5,2.5 0 0,1 12,11.5Z" />
                                            <TextBlock x:Name="txtLocation" Text="Şanlıurfa, Türkiye" FontSize="12.5" FontWeight="SemiBold" Foreground="#F8FAFC" />
                                        </StackPanel>
                                    </Button>

                                    <!-- Timezone Badge -->
                                    <Border DockPanel.Dock="Right" Background="#161F30" CornerRadius="5" Padding="6,2" BorderBrush="#222D40" BorderThickness="1">
                                        <TextBlock x:Name="txtTimezoneBadge" Text="Europe/Istanbul" FontSize="9.5" Foreground="#94A3B8" />
                                    </Border>
                                </DockPanel>

                                <!-- Gregorian + Hijri Date -->
                                <TextBlock x:Name="txtDualDate" Text="Wed, 18 Nov 2026 • 8 Jumada II 1448" 
                                           FontSize="11.5" Foreground="#94A3B8" Margin="0,0,0,8" />

                                <!-- Active Athan Playing Pulse Banner -->
                                <Border x:Name="bannerAudioPlaying" Visibility="Collapsed" Margin="0,0,0,8"
                                        Background="#0E232B" BorderBrush="#00D2B4" BorderThickness="1" CornerRadius="8" Padding="10,6">
                                    <DockPanel>
                                        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Path Width="13" Height="13" Stretch="Uniform" Fill="#00D2B4" Margin="0,0,6,0"
                                                  Data="M14,3.23V5.29C16.89,6.15 19,8.83 19,12C19,15.17 16.89,17.85 14,18.71V20.77C18.01,19.86 21,16.28 21,12C21,7.72 18.01,4.14 14,3.23M16.5,12C16.5,10.23 15.5,8.71 14,7.97V16C15.5,15.29 16.5,13.77 16.5,12M3,9V15H7L12,20V4L7,9H3Z" />
                                            <TextBlock Text="Athan audio is playing..." FontSize="11" FontWeight="SemiBold" Foreground="#00D2B4" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <Button DockPanel.Dock="Right" Content="Stop" Click="BtnStopAudio_Click"
                                                Background="#EF4444" Foreground="#FFFFFF" BorderThickness="0" Height="22" Padding="8,0" FontSize="10" FontWeight="Bold" Cursor="Hand" HorizontalAlignment="Right">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}" CornerRadius="4">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Border>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </DockPanel>
                                </Border>

                                <!-- Hero Next-Prayer Countdown Card -->
                                <Border Margin="0,0,0,8"
                                        BorderThickness="1"
                                        CornerRadius="12"
                                        Padding="14,12">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#10222D" Offset="0" />
                                            <GradientStop Color="#0B1720" Offset="1" />
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <Border.BorderBrush>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#1D4352" Offset="0" />
                                            <GradientStop Color="#132733" Offset="1" />
                                        </LinearGradientBrush>
                                    </Border.BorderBrush>

                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <!-- Top row: Pill badge + Target time -->
                                        <DockPanel Grid.Row="0">
                                            <Border DockPanel.Dock="Left" Background="#14343F" CornerRadius="4" Padding="6,2" BorderBrush="#1D4A59" BorderThickness="1">
                                                <StackPanel Orientation="Horizontal">
                                                    <Ellipse Width="5" Height="5" Fill="#00D2B4" Margin="0,0,5,0" VerticalAlignment="Center" />
                                                    <TextBlock Text="NEXT PRAYER" FontSize="9" FontWeight="Bold" Foreground="#00D2B4" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Border>
                                            <TextBlock x:Name="txtHeroPrayerTime" DockPanel.Dock="Right" Text="12:24"
                                                       FontSize="12" FontWeight="SemiBold" Foreground="#94A3B8" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                        </DockPanel>

                                        <!-- Center: Big Tabular Countdown & Prayer Name -->
                                        <Grid Grid.Row="1" Margin="0,6,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <!-- Digital Countdown -->
                                            <TextBlock x:Name="txtCountdown" Text="00:42:18"
                                                       FontSize="36" FontWeight="SemiBold"
                                                       Foreground="#00D2B4"
                                                       Typography.NumeralAlignment="Tabular"
                                                       VerticalAlignment="Center" />

                                            <!-- Prayer Name -->
                                            <TextBlock x:Name="txtHeroPrayerName" Grid.Column="1" Text="Dhuhr"
                                                       FontSize="22" FontWeight="Bold"
                                                       Foreground="#F8FAFC"
                                                       VerticalAlignment="Center" Margin="0,0,2,0" />
                                        </Grid>

                                        <!-- Bottom: Progress Bar -->
                                        <Grid Grid.Row="2">
                                            <Border Background="#16232D" CornerRadius="2.5" Height="5" />
                                            <Border x:Name="pbProgressFill"
                                                    Background="#00D2B4"
                                                    CornerRadius="2.5"
                                                    Height="5"
                                                    HorizontalAlignment="Left"
                                                    Width="150" />
                                        </Grid>
                                    </Grid>
                                </Border>

                                <!-- Daily Prayer Timetable (6 Rows) -->
                                <StackPanel Margin="0,0,0,6">
                                    <!-- Fajr Row -->
                                    <Border x:Name="RowFajr" Height="38" CornerRadius="8" Background="#121824" BorderBrush="#1E2638" BorderThickness="1" Margin="0,1" Padding="10,0">
                                        <Grid VerticalAlignment="Center">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="22" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="65" />
                                                <ColumnDefinition Width="26" />
                                            </Grid.ColumnDefinitions>
                                            <Path Grid.Column="0" Width="13" Height="13" Stretch="Uniform" Fill="#00D2B4"
                                                  Data="M5,16H19A1,1 0 0,0 20,15A1,1 0 0,0 19,14H5A1,1 0 0,0 4,15A1,1 0 0,0 5,16M12,4A5,5 0 0,0 7,9H17A5,5 0 0,0 12,4M1,18H23V20H1V18Z" />
                                            <TextBlock Grid.Column="1" Text="Fajr" FontSize="12.5" FontWeight="SemiBold" Foreground="#F8FAFC" VerticalAlignment="Center" Margin="6,0,0,0" />
                                            <Border x:Name="TagFajr" Grid.Column="2" Visibility="Collapsed" Background="#00D2B4" CornerRadius="3" Padding="4,1" Margin="0,0,6,0">
                                                <TextBlock Text="NEXT" FontSize="8" FontWeight="Bold" Foreground="#0B0F17" />
                                            </Border>
                                            <TextBlock x:Name="TimeFajr" Grid.Column="3" Text="05:21" FontSize="12.5" Foreground="#F8FAFC" Typography.NumeralAlignment="Tabular" VerticalAlignment="Center" HorizontalAlignment="Right" />
                                            <Button x:Name="BellFajr" Grid.Column="4" Style="{StaticResource PrayerBellButton}" Click="Bell_Click" Tag="Fajr" HorizontalAlignment="Right">
                                                <Path x:Name="BellIconFajr" Width="11" Height="11" Stretch="Uniform" Fill="#00D2B4" Data="M12,2A2,2 0 0,0 10,4A7,7 0 0,0 3,11V17L1,19V20H23V19L21,17V11A7,7 0 0,0 14,4A2,2 0 0,0 12,2M12,22A2,2 0 0,0 14,20H10A2,2 0 0,0 12,22Z" />
                                            </Button>
                                        </Grid>
                                    </Border>

                                    <!-- Sunrise Row -->
                                    <Border x:Name="RowSunrise" Height="38" CornerRadius="8" Background="#121824" BorderBrush="#1E2638" BorderThickness="1" Margin="0,1" Padding="10,0">
                                        <Grid VerticalAlignment="Center">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="22" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="65" />
                                                <ColumnDefinition Width="26" />
                                            </Grid.ColumnDefinitions>
                                            <Path Grid.Column="0" Width="13" Height="13" Stretch="Uniform" Fill="#F59E0B"
                                                  Data="M5,16H19A1,1 0 0,0 20,15A1,1 0 0,0 19,14H5A1,1 0 0,0 4,15A1,1 0 0,0 5,16M12,4L10.5,7H13.5L12,4M1,18H23V20H1V18M12,7A5,5 0 0,0 7,12H17A5,5 0 0,0 12,7Z" />
                                            <TextBlock Grid.Column="1" Text="Sunrise" FontSize="12.5" FontWeight="SemiBold" Foreground="#F8FAFC" VerticalAlignment="Center" Margin="6,0,0,0" />
                                            <Border x:Name="TagSunrise" Grid.Column="2" Visibility="Collapsed" Background="#00D2B4" CornerRadius="3" Padding="4,1" Margin="0,0,6,0">
                                                <TextBlock Text="NEXT" FontSize="8" FontWeight="Bold" Foreground="#0B0F17" />
                                            </Border>
                                            <TextBlock x:Name="TimeSunrise" Grid.Column="3" Text="06:44" FontSize="12.5" Foreground="#F8FAFC" Typography.NumeralAlignment="Tabular" VerticalAlignment="Center" HorizontalAlignment="Right" />
                                            <Button x:Name="BellSunrise" Grid.Column="4" Style="{StaticResource PrayerBellButton}" Click="Bell_Click" Tag="Sunrise" HorizontalAlignment="Right">
                                                <Path x:Name="BellIconSunrise" Width="11" Height="11" Stretch="Uniform" Fill="#475569" Data="M12,2A2,2 0 0,0 10,4A7,7 0 0,0 3,11V17L1,19V20H23V19L21,17V11A7,7 0 0,0 14,4A2,2 0 0,0 12,2M12,22A2,2 0 0,0 14,20H10A2,2 0 0,0 12,22Z" />
                                            </Button>
                                        </Grid>
                                    </Border>

                                    <!-- Dhuhr Row -->
                                    <Border x:Name="RowDhuhr" Height="38" CornerRadius="8" Background="#121824" BorderBrush="#1E2638" BorderThickness="1" Margin="0,1" Padding="10,0">
                                        <Grid VerticalAlignment="Center">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="22" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="65" />
                                                <ColumnDefinition Width="26" />
                                            </Grid.ColumnDefinitions>
                                            <Path Grid.Column="0" Width="13" Height="13" Stretch="Uniform" Fill="#38BDF8"
                                                  Data="M12,7A5,5 0 0,1 17,12A5,5 0 0,1 12,17A5,5 0 0,1 7,12A5,5 0 0,1 12,7M12,9A3,3 0 0,0 9,12A3,3 0 0,0 12,15A3,3 0 0,0 15,12A3,3 0 0,0 12,9M12,2L14.39,5.42C13.65,5.15 12.84,5 12,5C11.16,5 10.35,5.15 9.61,5.42L12,2M3.34,7L7.5,6.65C6.9,7.16 6.36,7.78 5.94,8.5C5.5,9.24 5.25,10 5.11,10.79L3.34,7M3.36,17L5.12,13.23C5.26,14 5.53,14.78 5.95,15.5C6.37,16.24 6.91,16.86 7.5,17.37L3.36,17M20.65,7L18.88,10.79C18.74,10 18.47,9.23 18.05,8.5C17.63,7.78 17.1,7.15 16.5,16.64L20.65,7M20.64,17L16.5,17.36C17.09,16.85 17.62,16.22 18.04,15.5C18.46,14.77 18.73,14 18.87,13.21L20.64,17Z" />
                                            <TextBlock Grid.Column="1" Text="Dhuhr" FontSize="12.5" FontWeight="SemiBold" Foreground="#F8FAFC" VerticalAlignment="Center" Margin="6,0,0,0" />
                                            <Border x:Name="TagDhuhr" Grid.Column="2" Visibility="Collapsed" Background="#00D2B4" CornerRadius="3" Padding="4,1" Margin="0,0,6,0">
                                                <TextBlock Text="NEXT" FontSize="8" FontWeight="Bold" Foreground="#0B0F17" />
                                            </Border>
                                            <TextBlock x:Name="TimeDhuhr" Grid.Column="3" Text="12:24" FontSize="12.5" Foreground="#F8FAFC" Typography.NumeralAlignment="Tabular" VerticalAlignment="Center" HorizontalAlignment="Right" />
                                            <Button x:Name="BellDhuhr" Grid.Column="4" Style="{StaticResource PrayerBellButton}" Click="Bell_Click" Tag="Dhuhr" HorizontalAlignment="Right">
                                                <Path x:Name="BellIconDhuhr" Width="11" Height="11" Stretch="Uniform" Fill="#00D2B4" Data="M12,2A2,2 0 0,0 10,4A7,7 0 0,0 3,11V17L1,19V20H23V19L21,17V11A7,7 0 0,0 14,4A2,2 0 0,0 12,2M12,22A2,2 0 0,0 14,20H10A2,2 0 0,0 12,22Z" />
                                            </Button>
                                        </Grid>
                                    </Border>

                                    <!-- Asr Row -->
                                    <Border x:Name="RowAsr" Height="38" CornerRadius="8" Background="#121824" BorderBrush="#1E2638" BorderThickness="1" Margin="0,1" Padding="10,0">
                                        <Grid VerticalAlignment="Center">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="22" />
                                                <ColumnDefinition Width="*" />
